# Copy to .env and fill in. The app creates the database, both tables and
# their indexes on first run — nothing needs setting up in pgAdmin beyond a
# server and a role allowed to create databases.

# ── PostgreSQL ───────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=interview_tracker
PG_USER=postgres
PG_PASSWORD=
# prefer = use TLS when the server offers it, plain text when it does not.
# A local server wants "prefer"; a managed Postgres over the internet wants
# "require".
PG_SSLMODE=prefer
PG_POOL_MAX=10

# A hosted Postgres usually hands you one connection string instead. Set it
# and everything above is ignored.
# DATABASE_URL=postgresql://user:password@host:5432/interview_tracker?sslmode=require

# ── CV storage ───────────────────────────────────────────────────────
CV_STORAGE_DIR=data/cvs
MAX_CV_MB=15

# ── Identity matching ────────────────────────────────────────────────
# 1.00 email · 0.95 LinkedIn/GitHub · 0.85 phone · 0.40 name.
IDENTITY_AUTO_LINK_MIN_CONFIDENCE=0.85
IDENTITY_DEFAULT_PHONE_REGION=BD

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
